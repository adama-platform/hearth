<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.hearth</groupId>
    <artifactId>hearth</artifactId>
    <name>Hearth</name>
    <description>A single-jar community server for communities of 100 to 1,000 people.</description>
    <version>${revision}</version>
    <dependencies>
        <!-- V8, for the dynamic JavaScript content kind. Two artifacts on purpose: `javet` is the
             Java half and is small, and the native V8 build is a separate per-platform jar. Only
             the platforms a server actually runs on are bundled, because each one is 14MB and the
             deliverable is a jar somebody copies to a box. A missing native is not fatal: the
             engine reports itself unavailable at boot and the JavaScript kind refuses to save,
             which is the honest failure rather than a page that renders as an error. -->
        <dependency>
            <groupId>com.caoccao.javet</groupId>
            <artifactId>javet</artifactId>
            <version>${javet.version}</version>
        </dependency>
        <dependency>
            <groupId>com.caoccao.javet</groupId>
            <artifactId>javet-v8-linux-x86_64</artifactId>
            <version>${javet.version}</version>
        </dependency>
        <dependency>
            <groupId>com.caoccao.javet</groupId>
            <artifactId>javet-v8-linux-arm64</artifactId>
            <version>${javet.version}</version>
        </dependency>
        <!-- ACME (Let's Encrypt) for automatic certificates; utils brings CSRBuilder and KeyPairUtils -->
        <dependency>
            <groupId>org.shredzone.acme4j</groupId>
            <artifactId>acme4j-client</artifactId>
            <version>2.14</version>
        </dependency>
        <dependency>
            <groupId>org.shredzone.acme4j</groupId>
