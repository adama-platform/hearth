{{<layout}}{{$body}}
<p class="crumb"><a href="{{backUrl}}">&larr; Projects</a></p>
<h1>{{name}}</h1>
{{#summary}}<p class="hint">{{.}}</p>{{/summary}}

{{#board}}
<div class="board">
  {{#columns}}
  <section class="column">
    <h2>{{name}} <span class="dim">{{count}}</span></h2>
    {{#tasks}}{{>task_card}}{{/tasks}}
    {{^any}}<p class="dim empty">nothing here</p>{{/any}}
  </section>
  {{/columns}}
</div>
{{/board}}

{{#groups}}
<section class="groupbox{{#sequenced}} ordered{{/sequenced}}">
  <h2>{{name}} <span class="pill">{{label}}</span></h2>
  <p class="hint">{{hint}}</p>
  {{#tasks}}{{>task_card}}{{/tasks}}
</section>
{{/groups}}

{{^board}}
{{#anyOpen}}<div class="items">{{#open}}{{>task_card}}{{/open}}</div>{{/anyOpen}}
{{^anyOpen}}<p class="empty">Nothing outstanding. Add something below.</p>{{/anyOpen}}
{{#anyDone}}
<h2>Done</h2>
<div class="items finished">{{#done}}{{>task_card}}{{/done}}</div>
{{/anyDone}}
{{/board}}

{{#anyHidden}}<p class="hint">{{hidden}} finished {{words}} are out of the way. They are kept
  &mdash; everything recorded against them is still in the history.</p>{{/anyHidden}}

<details class="reply">
  <summary>Add {{#board}}a card{{/board}}{{^board}}something{{/board}}</summary>
  <form method="post" action="{{action}}">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="add_task">
    <input type="hidden" name="project" value="{{id}}">
    {{#anyDefs}}
    <label for="t-def">what is it</label>
    <select id="t-def" name="def">
      <option value="">just a one-off, typed below</option>
      {{#defs}}<option value="{{id}}">{{name}} &mdash; {{measure}}</option>{{/defs}}
    </select>
    <p class="hint">Picking one brings its instructions and its measurements with it, and its
      history follows it from project to project.
      <a href="{{libraryUrl}}">Write a new one &rarr;</a></p>
    {{/anyDefs}}
    <label for="t-title">or call it</label>
    <input id="t-title" type="text" name="title" maxlength="256">
    <div class="two">
      <div><label for="t-repeat">comes back every
        <span class="dim">&mdash; days; 0 for a one-off</span></label>
        <input id="t-repeat" type="number" name="repeat_days" min="0" max="365" value="0"></div>
      <div><label for="t-due">due</label>
        <input id="t-due" type="date" name="due_on"></div>
    </div>
    <button type="submit">Add it</button>
  </form>
</details>

{{#mayEdit}}
<details class="reply">
  <summary>Settings</summary>
  <form method="post" action="{{action}}">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="edit_project">
    <input type="hidden" name="project" value="{{id}}">
    <label for="e-name">name</label>
    <input id="e-name" type="text" name="name" maxlength="128" value="{{name}}" required>
    <label for="e-summary">one line</label>
    <input id="e-summary" type="text" name="summary" maxlength="256" value="{{summary}}">
    <div class="two">
      <div><label for="e-word">one is a</label>
        <input id="e-word" type="text" name="task_word" maxlength="32" value="{{word}}"></div>
      <div><label for="e-words">several are</label>
        <input id="e-words" type="text" name="tasks_word" maxlength="32" value="{{words}}"></div>
    </div>
    <label for="e-phases">phases, comma separated
      <span class="dim">&mdash; empty is a plain list</span></label>
    <input id="e-phases" type="text" name="phases" maxlength="256"
           value="{{#phases}}{{.}}, {{/phases}}">
    <label for="e-hide">hide finished after (hours)</label>
    <input id="e-hide" type="number" name="hide_done_hours" min="0" max="8760">
    <button type="submit">Save</button>
  </form>
  <form method="post" action="{{action}}"
        onsubmit="return confirm('Delete this project? What you recorded is kept as history.')">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="delete_project">
    <input type="hidden" name="project" value="{{id}}">
    <button type="submit" class="quiet">Delete the project</button>
  </form>
</details>
{{/mayEdit}}
<style>
/* A board scrolls sideways rather than wrapping: on a phone a column at a time is the readable
   unit, and three squashed columns are none. */
.board{display:flex;gap:.7rem;overflow-x:auto;padding-bottom:.5rem;margin:0 0 1.2rem}
.board .column{flex:0 0 15rem;min-width:15rem}
.board .column h2{font-size:.8rem;text-transform:uppercase;letter-spacing:.04em;color:var(--dim);margin:0 0 .4rem}
.items{display:grid;gap:.45rem;margin:0 0 1.2rem}
/* A group is drawn as one thing, because it is one thing: a superset done as two cards a screen
   apart is a superset nobody performs as one. */
.groupbox{border:1px solid var(--accent);border-radius:12px;padding:.8rem .9rem;margin:0 0 1rem}
.groupbox h2{margin:0 0 .2rem;font-size:1rem;display:flex;gap:.5rem;align-items:baseline}
.groupbox .hint{margin:0 0 .6rem}
.groupbox.ordered{counter-reset:step}
.groupbox.ordered .card{counter-increment:step;position:relative}
.groupbox.ordered .card .what::before{content:counter(step) ". ";color:var(--dim)}
.items.finished{opacity:.6}
.two{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}
@media (max-width:32rem){.two{grid-template-columns:1fr}}
</style>
{{/body}}{{/layout}}
