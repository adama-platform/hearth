{{<layout}}{{$body}}
<p class="crumb"><a href="{{backUrl}}">&larr; Members</a></p>

<div class="profile">
  <span class="avatar big" aria-hidden="true">{{initial}}</span>
  <div class="named">
    <h1>{{name}}</h1>
    {{#anyHeadline}}<p class="tagline">{{headline}}</p>{{/anyHeadline}}
    <div class="meta">
      {{#anyLocation}}<span>{{location}}</span>{{/anyLocation}}
      {{#since}}{{#anyLocation}}<span class="sep">&middot;</span>{{/anyLocation}}<span>here since {{since}}</span>{{/since}}
    </div>
  </div>
</div>

<div class="doing">
  {{#me}}<a class="btn" href="{{selfUrl}}">Edit your profile</a>{{/me}}
</div>

{{#anyAbout}}<div class="post-body">{{{aboutHtml}}}</div>{{/anyAbout}}
{{^anyAbout}}<p class="hint">{{#me}}You have not written anything about yourself yet. It is the
  thing most likely to get somebody to say hello.{{/me}}{{^me}}They have not written anything about
  themselves yet.{{/me}}</p>{{/anyAbout}}

{{#anyLinks}}
<h2>Elsewhere</h2>
<ul class="links">{{#links}}<li>{{.}}</li>{{/links}}</ul>
{{/anyLinks}}
{{/body}}{{/layout}}
