{{!
  The three numbers the whole thing is for: how hard, how long, how much good it did.

  Radio buttons rather than a slider, because five options is a row of five things to press and a
  slider is a drag gesture nobody performs accurately at the end of a set. None of them is
  pre-selected: "did not say" is a different fact from "three", and a form that started in the
  middle would quietly turn every unanswered set into an average one.
}}
<div class="ratings">
  <fieldset>
    <legend>How hard <span class="dim">1 easy &middot; 5 brutal</span></legend>
    <div class="scale">
      {{#one}}{{/one}}
      <label><input type="radio" name="difficulty" value="1"><span>1</span></label>
      <label><input type="radio" name="difficulty" value="2"><span>2</span></label>
      <label><input type="radio" name="difficulty" value="3"><span>3</span></label>
      <label><input type="radio" name="difficulty" value="4"><span>4</span></label>
      <label><input type="radio" name="difficulty" value="5"><span>5</span></label>
    </div>
  </fieldset>
  <fieldset>
    <legend>How long it took <span class="dim">1 quick &middot; 5 ages</span></legend>
    <div class="scale">
      <label><input type="radio" name="time_cost" value="1"><span>1</span></label>
      <label><input type="radio" name="time_cost" value="2"><span>2</span></label>
      <label><input type="radio" name="time_cost" value="3"><span>3</span></label>
      <label><input type="radio" name="time_cost" value="4"><span>4</span></label>
      <label><input type="radio" name="time_cost" value="5"><span>5</span></label>
    </div>
  </fieldset>
  <fieldset>
    <legend>Worth doing <span class="dim">1 pointless &middot; 5 exactly what was needed</span></legend>
    <div class="scale">
      <label><input type="radio" name="impact" value="1"><span>1</span></label>
      <label><input type="radio" name="impact" value="2"><span>2</span></label>
      <label><input type="radio" name="impact" value="3"><span>3</span></label>
      <label><input type="radio" name="impact" value="4"><span>4</span></label>
      <label><input type="radio" name="impact" value="5"><span>5</span></label>
    </div>
  </fieldset>
</div>
<style>
.ratings fieldset{border:0;padding:0;margin:0 0 .7rem}
.ratings legend{padding:0;font-size:.8125rem;color:var(--dim);margin:0 0 .3rem}
.scale{display:flex;gap:.35rem}
.scale label{flex:1;position:relative}
.scale input{position:absolute;opacity:0;width:1px;height:1px}
.scale span{display:grid;place-items:center;min-height:44px;border:1px solid var(--line);border-radius:8px;cursor:pointer;font-weight:600;color:var(--dim)}
.scale label:has(input:checked) span{background:var(--accent);border-color:var(--accent);color:var(--bg)}
.scale label:has(input:focus-visible) span{outline:2px solid var(--accent);outline-offset:2px}
</style>
