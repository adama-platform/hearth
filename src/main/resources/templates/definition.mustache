{{<layout}}{{$body}}
<p class="crumb"><a href="{{backUrl}}">&larr; What things are</a></p>
<h1>{{name}}</h1>
<p class="meta">
  <span class="pill">{{measureLabel}}</span>
  {{#restSaid}}<span class="pill">rest {{.}}</span>{{/restSaid}}
  {{#isShared}}<span class="pill good">{{community}}'s</span>{{/isShared}}
  {{#tags}}<span class="pill">{{.}}</span>{{/tags}}
</p>
{{#summary}}<p class="hint">{{.}}</p>{{/summary}}

{{#anyInstructions}}
<section class="prose how">{{{instructions}}}</section>
{{/anyInstructions}}
{{#reference}}<p><a href="{{.}}" rel="noreferrer noopener">Where this came from &rarr;</a></p>{{/reference}}

<h2>How it has gone</h2>
{{^anyHistory}}<p class="empty">Nothing recorded yet.</p>{{/anyHistory}}
{{#anyHistory}}
<p class="tally">
  <span class="pill">{{occasions}} time(s)</span>
  <span class="pill">{{sets}} set(s)</span>
  {{#lastAt}}<span class="dim">last {{.}}</span>{{/lastAt}}
</p>
{{#oneRepMax}}
<p class="max"><strong>{{.}}kg</strong> <span class="dim">{{oneRepMaxLabel}}{{#oneRepMaxAt}}, from
  {{.}}{{/oneRepMaxAt}}</span></p>
<p class="hint">Epley's formula, from your best single set, and only offered up to {{honestReps}}
  reps &mdash; past that the number is about how long you can suffer rather than what you can lift.
  It is a direction, not a target.</p>
{{/oneRepMax}}
{{#rated}}
<table class="feedback">
  <tr><th>how hard</th><td>{{difficulty}} / 5</td></tr>
  <tr><th>how long</th><td>{{timeCost}} / 5</td></tr>
  <tr><th>worth doing</th><td>{{impact}} / 5</td></tr>
</table>
{{/rated}}
<p class="verdict">{{verdict}}</p>
<p class="hint">Measured in {{effortLabel}}. The bars are against your best.</p>
<ul class="history">
  {{#entries}}
  <li>
    <span class="bar"><span style="width:{{share}}%"></span></span>
    <span class="what">{{what}}</span>
    <span class="dim">{{when}}</span>
    {{#note}}<span class="dim">&mdash; {{.}}</span>{{/note}}
  </li>
  {{/entries}}
</ul>
{{/anyHistory}}

{{#mine}}
<details class="reply">
  <summary>Edit this definition</summary>
  <form method="post" action="{{action}}">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="edit_def">
    <input type="hidden" name="def" value="{{id}}">
    <label for="e-name">called</label>
    <input id="e-name" type="text" name="name" maxlength="128" value="{{name}}" required>
    <label for="e-measure">measured in</label>
    <select id="e-measure" name="measure">
      {{#measures}}<option value="{{name}}">{{label}}</option>{{/measures}}
    </select>
    <label for="e-summary">one line</label>
    <input id="e-summary" type="text" name="summary" maxlength="256" value="{{rawSummary}}">
    <label for="e-inst">how it is done</label>
    <textarea id="e-inst" name="instructions" rows="8">{{rawInstructions}}</textarea>
    <label for="e-ref">where the form came from</label>
    <input id="e-ref" type="url" name="reference_url" maxlength="512" value="{{rawReference}}">
    <label for="e-tags">tags</label>
    <input id="e-tags" type="text" name="tags" maxlength="256" value="{{rawTags}}">
    <label for="e-rest">rest between sets, in seconds</label>
    <input id="e-rest" type="number" name="rest_seconds" min="0" max="3600" value="{{restSeconds}}">
    <button type="submit">Save</button>
  </form>
  <form method="post" action="{{action}}">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="retire_def">
    <input type="hidden" name="def" value="{{id}}">
    <button type="submit" class="quiet">Stop offering it</button>
    <p class="hint">It comes off the lists. What you recorded against it is kept.</p>
  </form>
</details>
{{/mine}}
<style>
.tally{display:flex;gap:.4rem;align-items:center;flex-wrap:wrap;margin:0 0 .8rem}
.feedback{width:auto;margin:0 0 .8rem}
.feedback th{text-align:left;font-weight:400;color:var(--dim);padding:.2rem 1rem .2rem 0;text-transform:none;letter-spacing:0;font-size:.9375rem;border:0}
.feedback td{font-weight:600;border:0;padding:.2rem 0}
.max{font-size:1.15rem;margin:0 0 .3rem}
.verdict{border-left:3px solid var(--accent);padding:.5rem .9rem;background:var(--panel);border-radius:0 8px 8px 0;margin:0 0 1rem}
.history{list-style:none;margin:0 0 1.2rem;padding:0;font-size:.9375rem}
.history li{display:flex;align-items:center;gap:.6rem;padding:.35rem 0;border-bottom:1px solid var(--line)}
.history .bar{flex:0 0 5rem;height:.5rem;border-radius:3px;background:color-mix(in srgb,var(--fg) 8%,transparent);overflow:hidden}
.history .bar span{display:block;height:100%;background:var(--accent);border-radius:3px}
.history .what{font-weight:600}
.how{margin:0 0 1.2rem}
</style>
{{/body}}{{/layout}}
