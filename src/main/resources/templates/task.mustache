{{<layout}}{{$body}}
<p class="crumb"><a href="{{backUrl}}">&larr; {{projectName}}</a></p>
<h1>{{title}}</h1>
{{#summary}}<p class="hint">{{.}}</p>{{/summary}}
{{#notes}}<p class="hint">{{.}}</p>{{/notes}}

{{#groupName}}
<div class="group-strip">
  <span class="pill">{{groupLabel}}: {{.}}</span>
  <span class="dim">{{groupHint}}</span>
  {{#anySiblings}}
  <span class="with">{{#siblings}}<a href="{{url}}" class="{{#done}}was{{/done}}">{{title}}</a>{{/siblings}}</span>
  {{/anySiblings}}
</div>
{{/groupName}}

{{#hasSets}}
{{! The logging half. Everything above the fold is one gesture: the boxes are already filled with
    the last set's numbers, and the button under them is the biggest thing on the page. }}
<section class="logger">
  <h2>Set {{setNumber}}</h2>
  <form method="post" action="{{action}}">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="log_set">
    <input type="hidden" name="task" value="{{id}}">
    <div class="boxes">
      {{#boxes}}
      <label>
        <span>{{label}}{{#unit}} <span class="dim">({{.}})</span>{{/unit}}</span>
        <input type="text" inputmode="decimal" name="{{name}}"
               value="{{#whole}}{{/whole}}" placeholder="{{#signed}}+/-{{/signed}}">
      </label>
      {{/boxes}}
    </div>
    <button type="submit" class="big">Log it</button>
    {{#nextUrl}}<p class="then">then <a href="{{.}}">{{nextName}} &rarr;</a></p>{{/nextUrl}}
    <details class="rate">
      <summary>How was it?</summary>
      {{>ratings}}
      <label for="s-note">a note</label>
      <input id="s-note" type="text" name="note" maxlength="256"
             placeholder="left knee, felt easy, rushed">
    </details>
  </form>
</section>

{{#sinceLast}}
{{! Rendered by the server in words, so it is right with no JavaScript at all; /~rest.js only makes
    the number move. A superset rests after the round, so the target is not shown between its
    parts -- getting that backwards turns a time-saving device into one that takes longer. }}
<div class="rest" data-rest="{{#restsHere}}{{restSeconds}}{{/restsHere}}{{^restsHere}}0{{/restsHere}}"
     data-since="{{.}}" data-state="{{#restsHere}}resting{{/restsHere}}">
  <span class="clock" data-rest-count>{{sinceLastSaid}} since your last set</span>
  {{#restsHere}}{{#restSaid}}<span class="dim">rest {{.}}</span>{{/restSaid}}{{/restsHere}}
  {{^restsHere}}<span class="dim">rest after the round, not between</span>{{/restsHere}}
</div>
{{/sinceLast}}

{{#anyToday}}
<h2>Today</h2>
<ol class="sets">
  {{#today}}
  <li>
    <span class="what">{{what}}</span>
    <span class="dim">{{when}}</span>
    {{#note}}<span class="dim">&mdash; {{.}}</span>{{/note}}
    <form method="post" action="{{action}}" class="inline">
      <input type="hidden" name="csrf" value="{{csrf}}">
      <input type="hidden" name="action" value="delete_entry">
      <input type="hidden" name="entry" value="{{id}}">
      <button type="submit" class="undo" aria-label="undo this set">&times;</button>
    </form>
  </li>
  {{/today}}
</ol>
{{/anyToday}}
{{/hasSets}}

{{^hasSets}}
<section class="logger">
  {{^done}}
  <form method="post" action="{{action}}">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="complete">
    <input type="hidden" name="task" value="{{id}}">
    <button type="submit" class="big">Done</button>
    <details class="rate">
      <summary>How was it?</summary>
      {{>ratings}}
      <label for="d-note">a note</label>
      <input id="d-note" type="text" name="note" maxlength="256">
    </details>
  </form>
  {{/done}}
  {{#done}}
  <p class="done">Done. {{#repeats}}It comes back on its own.{{/repeats}}</p>
  <form method="post" action="{{action}}" class="inline">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="complete">
    <input type="hidden" name="task" value="{{id}}">
    <input type="hidden" name="done" value="0">
    <button type="submit" class="quiet">not done after all</button>
  </form>
  {{/done}}
</section>
{{/hasSets}}

{{#anyInstructions}}
<details class="how" {{^anyBefore}}open{{/anyBefore}}>
  <summary>How it is done</summary>
  <div class="prose">{{{instructions}}}</div>
  {{#reference}}<p><a href="{{.}}" rel="noreferrer noopener">Where this came from &rarr;</a></p>{{/reference}}
</details>
{{/anyInstructions}}

{{#anyBefore}}
<h2>Before</h2>
<ul class="before">
  {{#before}}<li><span class="what">{{what}}</span> <span class="dim">{{when}}</span>{{#note}} <span class="dim">&mdash; {{.}}</span>{{/note}}</li>{{/before}}
</ul>
{{#defUrl}}<p><a href="{{.}}">All of it, and whether it is worth its place &rarr;</a></p>{{/defUrl}}
{{/anyBefore}}

<details class="reply">
  <summary>Do it with something else</summary>
  <form method="post" action="{{action}}">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="group_task">
    <input type="hidden" name="task" value="{{id}}">
    <label for="g-name">group name <span class="dim">&mdash; anything on this project with the
      same name is done with it; empty to leave</span></label>
    <input id="g-name" type="text" name="group_name" maxlength="64" value="{{groupName}}">
    <label for="g-mode">how</label>
    <select id="g-mode" name="group_mode">
      <option value="related">superset &mdash; alternate, and rest after the round</option>
      <option value="sequenced">in order &mdash; a circuit, or building into a working set</option>
    </select>
    <button type="submit">Save</button>
  </form>
</details>

<details class="reply">
  <summary>Edit this</summary>
  <form method="post" action="{{action}}">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="edit_task">
    <input type="hidden" name="task" value="{{id}}">
    <label for="t-title">called</label>
    <input id="t-title" type="text" name="title" maxlength="256" value="{{title}}" required>
    <label for="t-notes">notes</label>
    <textarea id="t-notes" name="notes" rows="3">{{notes}}</textarea>
    <div class="two">
      <div><label for="t-repeat">comes back every (days)</label>
        <input id="t-repeat" type="number" name="repeat_days" min="0" max="365"></div>
      <div><label for="t-due">due</label>
        <input id="t-due" type="date" name="due_on" value="{{due}}"></div>
    </div>
    <button type="submit">Save</button>
  </form>
  <form method="post" action="{{action}}"
        onsubmit="return confirm('Remove this? What you recorded against it is kept.')">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="delete_task">
    <input type="hidden" name="task" value="{{id}}">
    <button type="submit" class="quiet">Remove it from this project</button>
  </form>
</details>
<style>
.logger{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:1rem;margin:0 0 1.2rem}
.logger h2{margin:0 0 .6rem;font-size:.8rem;text-transform:uppercase;letter-spacing:.04em;color:var(--dim)}
.boxes{display:flex;gap:.6rem;margin:0 0 .8rem}
.boxes label{flex:1;display:flex;flex-direction:column;gap:.25rem;font-size:.8125rem;color:var(--dim)}
.boxes input{font-size:1.4rem;font-weight:600;text-align:center;padding:.6rem .3rem;min-height:56px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--fg)}
button.big{width:100%;min-height:52px;font:inherit;font-size:1.05rem;font-weight:650;border:0;border-radius:10px;background:var(--accent);color:var(--bg);cursor:pointer}
.rate{margin:.7rem 0 0}
.rate summary{cursor:pointer;min-height:44px;display:flex;align-items:center;color:var(--dim);font-size:.9375rem}
.sets{list-style:none;counter-reset:s;margin:0 0 1.2rem;padding:0}
.sets li{counter-increment:s;display:flex;align-items:center;gap:.5rem;padding:.5rem .1rem;border-bottom:1px solid var(--line)}
.sets li::before{content:counter(s);flex:0 0 1.6rem;height:1.6rem;display:grid;place-items:center;border-radius:50%;background:color-mix(in srgb,var(--fg) 8%,transparent);font-size:.75rem;color:var(--dim)}
.sets .what{font-weight:600}
.sets .inline{margin-left:auto}
.undo{min-height:36px;min-width:36px;border:0;background:none;color:var(--dim);font-size:1.1rem;cursor:pointer}
.undo:hover{color:var(--bad)}
.before{list-style:none;margin:0 0 1rem;padding:0;font-size:.9375rem}
.before li{padding:.3rem 0;border-bottom:1px solid var(--line)}
.how summary{cursor:pointer;min-height:44px;display:flex;align-items:center;font-weight:600}
.two{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}
@media (max-width:32rem){.two{grid-template-columns:1fr}}
.rest{display:flex;gap:.6rem;align-items:baseline;padding:.6rem .9rem;border-radius:10px;margin:0 0 1rem;background:color-mix(in srgb,var(--fg) 5%,transparent)}
.rest[data-state="resting"]{background:color-mix(in srgb,var(--warn) 16%,transparent)}
.rest[data-state="ready"]{background:color-mix(in srgb,var(--good) 16%,transparent)}
.rest .clock{font-weight:650;font-variant-numeric:tabular-nums}
.group-strip{display:flex;gap:.5rem;align-items:baseline;flex-wrap:wrap;margin:0 0 .9rem;font-size:.9375rem}
.group-strip .with{display:flex;gap:.5rem}
.group-strip .with a{text-decoration:none}
.group-strip .with a.was{color:var(--dim);text-decoration:line-through}
.then{margin:.6rem 0 0;text-align:center;font-size:.9375rem;color:var(--dim)}
</style>
<script src="/~rest.js" defer></script>
{{/body}}{{/layout}}
