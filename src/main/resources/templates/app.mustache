<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="{{themeColor}}">
<meta name="color-scheme" content="light">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<script src="/~theme.js"></script><title>{{community}}</title>
<link rel="icon" href="{{favicon}}">
<link rel="manifest" href="/manifest.webmanifest">
<style>
:root{color-scheme:light;--bg:#fbfbfa;--fg:#1a1a1a;--line:#e3e3e0;--dim:#6b6b6b;--accent:#2f5cff}
/* the shell follows whatever the site inside it was told, which the theme script sets from the
   same stored answer -- an installed app that is light around a dark page looks broken */
:root[data-theme="dark"]{color-scheme:dark;--bg:#141413;--fg:#e8e8e6;--line:#2e2e2c;--dim:#9a9a96;--accent:#8aa4ff}
html,body{margin:0;height:100%;background:var(--bg);color:var(--fg);font:16px/1.5 -apple-system,system-ui,Segoe UI,Roboto,sans-serif}
body{display:flex;flex-direction:column;padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)}
#frame{flex:1 1 auto;width:100%;border:0;display:block;background:var(--bg)}
#bar{display:flex;gap:.6rem;align-items:center;padding:.45rem .8rem;border-top:1px solid var(--line);font-size:.8rem;color:var(--dim);background:var(--bg)}
#bar button{font:inherit;padding:.25rem .7rem;border:1px solid var(--line);border-radius:999px;background:transparent;color:var(--fg);cursor:pointer}
#bar .grow{flex:1 1 auto}
#bar[hidden]{display:none}
#say{padding:.45rem .8rem;font-size:.8rem;color:var(--dim)}
</style>
</head>
<body>
<iframe id="frame" src="{{start}}" title="{{community}}"></iframe>
<div id="bar" hidden>
  <span id="say"></span>
  <span class="grow"></span>
  <button type="button" id="notify" hidden>Turn on notifications</button>
  <button type="button" id="quiet" hidden>Turn them off</button>
</div>

<script nonce="{{nonce}}" data-push="{{pushUrl}}" data-csrf="{{csrf}}" data-key="{{vapidKey}}" data-signed-in="{{signedIn}}">
(function () {
  var cfg = document.currentScript;
  var pushUrl = cfg.getAttribute('data-push');
  var csrf = cfg.getAttribute('data-csrf');
  var key = cfg.getAttribute('data-key');
  var signedIn = cfg.getAttribute('data-signed-in') === 'true';
  var bar = document.getElementById('bar');
  var say = document.getElementById('say');
  var notify = document.getElementById('notify');
  var quiet = document.getElementById('quiet');
  var frame = document.getElementById('frame');

  // Keep the address bar honest: the shell holds the site, but a URL somebody copies should be the
  // page they are looking at rather than /~app forever. Same-origin only, so this cannot be used to
  // make the bar say something the frame is not showing.
  frame.addEventListener('load', function () {
    try {
      var here = frame.contentWindow.location;
      if (here.origin === window.location.origin) {
        history.replaceState(null, '', '/~app?to=' + encodeURIComponent(here.pathname + here.search));
      }
    } catch (e) { /* cross-origin, which should not happen; leave the bar alone */ }
  });

  if (!signedIn || !('serviceWorker' in navigator) || !('PushManager' in window) || !key) {
    return;
  }

  function urlBase64ToUint8Array(base64) {
    var padded = (base64 + '===').slice(0, base64.length + (4 - base64.length % 4) % 4);
    var raw = atob(padded.replace(/-/g, '+').replace(/_/g, '/'));
    var out = new Uint8Array(raw.length);
    for (var i = 0; i < raw.length; i++) { out[i] = raw.charCodeAt(i); }
    return out;
  }

  function post(body) {
    body.append('csrf', csrf);
    return fetch(pushUrl, {method: 'POST', body: body, credentials: 'same-origin'});
  }

  function show(state) {
    bar.hidden = false;
    notify.hidden = state === 'on' || state === 'blocked';
    quiet.hidden = state !== 'on';
    say.textContent = state === 'on' ? 'Notifications are on for this device.'
      : state === 'blocked' ? 'This browser is blocking notifications.'
      : 'Get told when somebody replies.';
  }

  // Re-entrant on purpose: this runs on every load of the shell, and every step is a no-op when it
  // has already happened. register() returns the existing registration, getSubscription() returns
  // the existing subscription, and posting it again updates one row rather than adding one. A
  // browser that has been reinstalled, or whose subscription the push service rotated, quietly
  // repairs itself on the next visit instead of going silent until somebody notices.
  navigator.serviceWorker.register('/sw.js', {scope: '/'}).then(function (reg) {
    return reg.pushManager.getSubscription().then(function (existing) {
      if (existing) {
        return sync(existing).then(function () { show('on'); });
      }
      show(Notification.permission === 'denied' ? 'blocked' : 'off');
      notify.addEventListener('click', function () {
        Notification.requestPermission().then(function (permission) {
          if (permission !== 'granted') { show(permission === 'denied' ? 'blocked' : 'off'); return; }
          reg.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: urlBase64ToUint8Array(key)
          }).then(function (sub) {
            return sync(sub).then(function () { show('on'); });
          }).catch(function () { show('off'); });
        });
      });
    });
  }).catch(function () { /* no worker, no push; the site is unaffected */ });

  function sync(sub) {
    var raw = sub.toJSON();
    var body = new FormData();
    body.append('endpoint', sub.endpoint);
    body.append('p256dh', raw.keys.p256dh);
    body.append('auth', raw.keys.auth);
    return post(body);
  }

  quiet.addEventListener('click', function () {
    navigator.serviceWorker.ready.then(function (reg) {
      return reg.pushManager.getSubscription().then(function (sub) {
        var body = new FormData();
        body.append('action', 'off');
        return post(body).then(function () { return sub ? sub.unsubscribe() : null; });
      });
    }).then(function () { show('off'); });
  });
})();
</script>
</body>
</html>
