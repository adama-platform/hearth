{{<layout}}{{$body}}
<h1>Events</h1>

{{#suggestedYes}}<p class="done">Thank you &mdash; that has gone to whoever looks after the
  calendar. It appears here once somebody says yes.</p>{{/suggestedYes}}
{{#suggestedNo}}<p class="problem">That needed at least a name and a first day.</p>{{/suggestedNo}}

<div class="doing">
  {{#mayCreate}}<a class="btn" href="{{newUrl}}">New event</a>{{/mayCreate}}
  {{#maySuggest}}<a class="btn secondary" href="#suggest">Suggest something</a>{{/maySuggest}}
</div>

{{^anyUpcoming}}<p class="empty"><strong>Nothing planned yet.</strong>
  {{#maySuggest}}If there is something you would go to, say so below &mdash; that is how most of
  what happens here starts.{{/maySuggest}}
  {{^maySuggest}}When somebody organises something, it turns up here.{{/maySuggest}}</p>{{/anyUpcoming}}
{{#anyUpcoming}}
<ul class="events">
  {{#upcoming}}
  <li class="{{#cancelled}}off{{/cancelled}}{{#today}} now{{/today}}">
    <div class="date" aria-hidden="true"><span class="d">{{day}}</span><span class="m">{{month}}</span></div>
    <div class="what">
      <a class="subject" href="{{url}}">{{title}}</a>
      <div class="meta">
        <span>{{when}}</span>
        {{#anyTime}}<span class="sep">&middot;</span><span>{{startTime}}</span>{{/anyTime}}
        {{#anyPlace}}<span class="sep">&middot;</span><span class="where">{{placeName}}</span>{{/anyPlace}}
        {{#anyLocation}}<span class="sep">&middot;</span><span>{{location}}</span>{{/anyLocation}}
        {{#cancelled}}<span class="pill red">cancelled</span>{{/cancelled}}
        {{#today}}<span class="pill good">today</span>{{/today}}
      </div>
      <div class="meta">
        <span>{{goingCount}} going</span>
        {{#maybeCount}}<span class="sep">&middot;</span><span>{{.}} maybe</span>{{/maybeCount}}
        {{#waitlistCount}}<span class="sep">&middot;</span><span>{{.}} waiting</span>{{/waitlistCount}}
        {{#limited}}{{#full}}<span class="pill warn">full</span>{{/full}}{{^full}}<span class="pill">{{seatsLeft}} left</span>{{/full}}{{/limited}}
        {{#iAmGoing}}<span class="pill blue">you are going</span>{{/iAmGoing}}
        {{#iAmMaybe}}<span class="pill blue">you said maybe</span>{{/iAmMaybe}}
        {{#iAmWaiting}}<span class="pill warn">you are waiting</span>{{/iAmWaiting}}
      </div>
    </div>
  </li>
  {{/upcoming}}
</ul>
{{/anyUpcoming}}

{{#maySuggest}}
<section id="suggest">
  <h2>Suggest something</h2>
  <p class="hint">Anybody here can put something forward. It goes to whoever looks after the
    calendar rather than straight onto it &mdash; which is what makes it safe to let everybody
    ask.</p>
  {{#anyWaiting}}<p class="hint">You have {{#waiting}}<strong>{{title}}</strong> on {{when}};
    {{/waiting}}waiting for an answer.</p>{{/anyWaiting}}
  <form method="post" action="{{action}}">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="suggest">
    <div class="field"><label for="s-title">what is it</label>
      <input id="s-title" type="text" name="title" maxlength="256" required></div>
    <div class="field"><label for="s-starts">which day</label>
      <input id="s-starts" type="date" name="starts_on" required></div>
    <div class="field"><label for="s-time">time <span class="dim">&mdash; as you would say it</span></label>
      <input id="s-time" type="text" name="start_time" maxlength="64" placeholder="doors at 7"></div>
    {{#anyPlaces}}
    <div class="field"><label for="s-place">where</label>
      <select id="s-place" name="place">
        <option value="">somewhere else</option>
        {{#places}}<option value="{{id}}">{{name}}</option>{{/places}}
      </select></div>
    {{/anyPlaces}}
    <div class="field"><label for="s-where">{{#anyPlaces}}or an address{{/anyPlaces}}{{^anyPlaces}}where{{/anyPlaces}}</label>
      <input id="s-where" type="text" name="location" maxlength="512"></div>
    <div class="field"><label for="s-body">anything else worth knowing</label>
      <textarea id="s-body" name="body" rows="4"></textarea></div>
    <div class="doing"><button type="submit">Suggest it</button></div>
  </form>
</section>
{{/maySuggest}}

{{#anyPast}}
<details class="revise">
  <summary>Already happened</summary>
  <ul class="events past">
    {{#past}}
    <li>
      <div class="date" aria-hidden="true"><span class="d">{{day}}</span><span class="m">{{month}}</span></div>
      <div class="what">
        <a class="subject" href="{{url}}">{{title}}</a>
        <div class="meta"><span>{{when}}</span>{{#anyPlace}}<span class="sep">&middot;</span><span>{{placeName}}</span>{{/anyPlace}}<span class="sep">&middot;</span><span>{{goingCount}} went</span></div>
      </div>
    </li>
    {{/past}}
  </ul>
</details>
{{/anyPast}}
{{/body}}{{/layout}}
