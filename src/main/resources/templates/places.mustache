{{<layout}}{{$body}}
<h1>Places</h1>
{{^anyTypes}}<p class="empty"><strong>Nothing here yet.</strong>Somebody with the permission
  decides what kinds of place this community keeps &mdash; ranches, vendors, venues, whatever is
  useful &mdash; and what is worth writing down about each.</p>{{/anyTypes}}
{{#anyTypes}}
<ul class="kinds">
  {{#types}}
  <li><a class="card" href="{{url}}">
    <h3>{{plural}}</h3>
    <div class="meta"><span>{{count}}</span>{{#description}}<span class="sep">&middot;</span><span>{{description}}</span>{{/description}}</div>
  </a></li>
  {{/types}}
</ul>
{{/anyTypes}}
{{/body}}{{/layout}}
