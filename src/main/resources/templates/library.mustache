{{<layout}}{{$body}}
<p class="crumb"><a href="{{backUrl}}">&larr; Projects</a></p>
<h1>What things are</h1>
<p class="hint">A definition is written once and used everywhere: what the movement is, how it is
  performed, what it is measured in. Your history follows the definition, so the same exercise in a
  new routine still knows what you did last month.</p>

{{#anyMine}}
<h2>Yours</h2>
<div class="defs">
  {{#mine}}
  <a class="def" href="{{url}}">
    <span class="name">{{name}}{{#derived}} <span class="pill">from the community's</span>{{/derived}}</span>
    <span class="dim">{{measure}}{{#summary}} &middot; {{.}}{{/summary}}</span>
  </a>
  {{/mine}}
</div>
{{/anyMine}}
{{^anyMine}}<p class="empty">Nothing of your own yet.</p>{{/anyMine}}

{{#anyShared}}
<h2>{{community}}'s library</h2>
<p class="hint">Take a copy of one and it stays pointed at this one, so improvements to the
  instructions reach you.</p>
<div class="defs">
  {{#shared}}
  <div class="def row">
    <a href="{{url}}"><span class="name">{{name}}</span>
      <span class="dim">{{measure}}{{#summary}} &middot; {{.}}{{/summary}}</span></a>
    {{^taken}}
    <form method="post" action="{{action}}" class="inline">
      <input type="hidden" name="csrf" value="{{csrf}}">
      <input type="hidden" name="action" value="adopt">
      <input type="hidden" name="def" value="{{id}}">
      <button type="submit" class="quiet">Take a copy</button>
    </form>
    {{/taken}}
    {{#taken}}<span class="dim">yours already</span>{{/taken}}
  </div>
  {{/shared}}
</div>
{{/anyShared}}

<details class="reply">
  <summary>Write a new one</summary>
  <form method="post" action="{{action}}">
    <input type="hidden" name="csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="new_def">
    <label for="d-name">what it is called</label>
    <input id="d-name" type="text" name="name" maxlength="128" required>
    <label for="d-measure">what it is measured in</label>
    <select id="d-measure" name="measure">
      {{#measures}}<option value="{{name}}">{{label}} &mdash; {{hint}}</option>{{/measures}}
    </select>
    <label for="d-summary">one line</label>
    <input id="d-summary" type="text" name="summary" maxlength="256">
    <label for="d-inst">how it is done <span class="dim">&mdash; markdown; this is what you read
      when you cannot remember the form</span></label>
    <textarea id="d-inst" name="instructions" rows="6"></textarea>
    <label for="d-ref">where the form came from</label>
    <input id="d-ref" type="url" name="reference_url" maxlength="512" placeholder="https://">
    <label for="d-tags">tags, comma separated</label>
    <input id="d-tags" type="text" name="tags" maxlength="256" placeholder="legs, pull, admin">
    <div class="two">
      <div><label for="d-sets">usual sets</label>
        <input id="d-sets" type="number" name="target_sets" min="1" max="20"></div>
      <div><label for="d-reps">usual reps</label>
        <input id="d-reps" type="number" name="target_reps" min="1" max="500"></div>
    </div>
    <label for="d-rest">rest between sets, in seconds <span class="dim">&mdash; a property of the
      movement, so it follows this everywhere; 0 for no particular rest</span></label>
    <input id="d-rest" type="number" name="rest_seconds" min="0" max="3600" placeholder="90">
    {{#mayShare}}<label class="check"><input type="checkbox" name="share"> put it in the
      community's library</label>{{/mayShare}}
    <button type="submit">Write it down</button>
  </form>
</details>
<style>
.defs{display:grid;gap:.4rem;margin:0 0 1.5rem}
.def{display:flex;flex-direction:column;gap:.1rem;padding:.7rem .9rem;border:1px solid var(--line);border-radius:10px;background:var(--panel);text-decoration:none;color:inherit;min-height:44px}
.def.row{flex-direction:row;align-items:center;gap:.6rem}
.def.row a{flex:1;text-decoration:none;color:inherit;display:flex;flex-direction:column}
.def:hover{border-color:var(--accent)}
.def .name{font-weight:600}
.two{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}
</style>
{{/body}}{{/layout}}
