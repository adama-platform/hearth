{{<layout}}{{$body}}
<h1>Hello, {{name}}</h1>

{{#anyTodo}}
<section class="waiting">
  <h2>Waiting for you</h2>
  <ul class="todo">
    {{#todo}}
    <li>
      <div class="what"><strong>{{title}}</strong><span class="hint">{{why}}</span></div>
      <a class="btn small" href="{{href}}">{{action}}</a>
    </li>
    {{/todo}}
  </ul>
</section>
{{/anyTodo}}

{{#hasCalendar}}
<section>
  <h2>The next week</h2>
  {{^anyWeek}}
  <p class="hint">Nothing in the next seven days.
    <a href="{{calendarUrl}}">The whole calendar &rarr;</a></p>
  {{/anyWeek}}
  {{#anyWeek}}
  <ul class="events">
    {{#week}}
    <li{{#cancelled}} class="off"{{/cancelled}}>
      <div class="what">
        <a class="subject" href="{{href}}">{{title}}</a>
        <p class="meta">
          <span>{{day}}</span>{{#time}}<span class="sep">&middot;</span><span>{{.}}</span>{{/time}}
          {{#where}}<span class="sep">&middot;</span><span>{{.}}</span>{{/where}}
          {{#cancelled}}<span class="pill warn">called off</span>{{/cancelled}}
          {{#answered}}<span class="pill green">{{answer}}</span>{{/answered}}
          {{^answered}}{{^cancelled}}<span class="pill">no answer yet</span>{{/cancelled}}{{/answered}}
        </p>
      </div>
    </li>
    {{/week}}
  </ul>
  <p class="hint"><a href="{{calendarUrl}}">Everything that is coming up &rarr;</a></p>
  {{/anyWeek}}
</section>
{{/hasCalendar}}

{{#hasBoard}}
<section>
  <h2>Conversations you are in</h2>
  {{^anyMine}}
  <p class="hint">None yet. Saying something in a thread is what puts it here &mdash; there is no
    button to press.</p>
  {{/anyMine}}
  {{#anyMine}}
  <ul class="feed">
    {{#mine}}
    <li>
      <a class="subject" href="{{href}}">{{title}}</a>
      <p class="meta">
        <span>{{who}}</span>
        {{#anyComments}}<span class="sep">&middot;</span><span>{{comments}} replies</span>{{/anyComments}}
        <span class="sep">&middot;</span><span>{{when}}</span>
        {{#pinned}}<span class="pill blue">pinned</span>{{/pinned}}
        {{#ageing}}<span class="pill warn">going soon</span>{{/ageing}}
      </p>
    </li>
    {{/mine}}
  </ul>
  {{/anyMine}}

  {{#anyRest}}
  <h2>Elsewhere on the board</h2>
  <ul class="feed">
    {{#rest}}
    <li>
      <a class="subject" href="{{href}}">{{title}}</a>
      <p class="meta">
        <span>{{who}}</span>
        {{#anyComments}}<span class="sep">&middot;</span><span>{{comments}} replies</span>{{/anyComments}}
        <span class="sep">&middot;</span><span>{{when}}</span>
      </p>
    </li>
    {{/rest}}
  </ul>
  {{/anyRest}}
  <p class="hint"><a href="{{boardUrl}}">The whole board &rarr;</a></p>
</section>
{{/hasBoard}}
{{/body}}{{/layout}}
