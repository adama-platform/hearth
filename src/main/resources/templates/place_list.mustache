{{<layout}}{{$body}}
<p class="crumb"><a href="{{backUrl}}">&larr; Places</a></p>
<h1>{{plural}}</h1>
{{#description}}<p class="hint">{{.}}</p>{{/description}}

<form class="tools" method="get" action="{{action}}">
  <input type="search" name="q" value="{{q}}" placeholder="name, address or anything recorded" aria-label="search {{plural}}">
  <button type="submit">Search</button>
</form>

{{^anyPlaces}}<p class="hint">Nothing here{{#q}} matching that{{/q}}.</p>{{/anyPlaces}}
{{#anyPlaces}}
<p class="count">{{count}}</p>
<ul class="places">
  {{#places}}
  <li>
    <a class="subject" href="{{url}}">{{name}}</a>
    {{#anyAddress}}<div class="meta">{{address}}</div>{{/anyAddress}}
    {{#anyFields}}
    <dl class="facets">{{#fields}}{{#any}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/any}}{{/fields}}</dl>
    {{/anyFields}}
  </li>
  {{/places}}
</ul>
{{/anyPlaces}}
{{/body}}{{/layout}}
