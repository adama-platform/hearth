{{<layout}}{{$body}}
{{#resumed}}<p class="hint">Picking up where you left off.</p>{{/resumed}}
<ol class="steps" aria-label="Getting started">
  <li class="{{#onName}}on{{/onName}}{{^onName}}past{{/onName}}">Your name</li>
  {{#hasSurvey}}<li class="{{#onQuestions}}on{{/onQuestions}}{{#onDone}}past{{/onDone}}">A few questions</li>{{/hasSurvey}}
  <li class="{{#onDone}}on{{/onDone}}">Done</li>
</ol>

{{#onName}}
<h1>Welcome. What should we call you?</h1>
<p class="lead">This is the one thing we do need. It goes on anything you write here, and on any
  invitation you send &mdash; an email address is not a person.</p>
<form method="post" action="{{action}}">
  <input type="hidden" name="csrf" value="{{csrf}}">
  <input type="hidden" name="action" value="name">
  <div class="field"><label for="display_name">your name</label>
    <input id="display_name" name="display_name" type="text" maxlength="128" required
           autocomplete="name" autofocus value="{{form_display_name}}"></div>
  <div class="field"><label for="location">where you are <span class="dim">(optional)</span></label>
    <input id="location" name="location" type="text" maxlength="128"
           autocomplete="address-level2" value="{{form_location}}"></div>
  <div class="field"><label for="about">anything about you <span class="dim">(optional)</span></label>
    <textarea id="about" name="about" rows="4" maxlength="8192">{{form_about}}</textarea>
    <p class="hint">A line or two is plenty. You can write more later.</p></div>
  <button type="submit">Continue</button>
</form>
{{/onName}}

{{#onQuestions}}
{{#returning}}<h1>Welcome back</h1>
<p class="lead">The people running {{community}} have asked the community something since you were
  last here. {{#anyQuestions}}Here {{#questionCount}}{{.}}{{/questionCount}} of them.{{/anyQuestions}}</p>{{/returning}}
{{^returning}}<h1>A few questions</h1>{{/returning}}
{{#anyQuestions}}
<p class="lead">{{^returning}}This community asks its members these. {{/returning}}Three at a time,
  and you can skip any of them.</p>
{{#total}}<p class="hint">{{answeredSoFar}} of {{total}} answered.{{#anyMore}} {{more}} more after
  these.{{/anyMore}}</p>{{/total}}
<form method="post" action="{{action}}">
  <input type="hidden" name="csrf" value="{{csrf}}">
  <input type="hidden" name="action" value="answers">
  {{#questions}}{{>ask}}{{/questions}}
  <div class="doing">
    <button type="submit">{{#anyMore}}Save and next{{/anyMore}}{{^anyMore}}Save and finish{{/anyMore}}</button>
    <a class="btn secondary" href="{{action}}?step=3">Skip for now</a>
  </div>
  <p class="hint">Skipping is fine and gets you into the site straight away &mdash; whatever is left
    waits on your questions page, and the bar at the top says how many.</p>
</form>
{{/anyQuestions}}
{{^anyQuestions}}
<p class="lead">Nothing is being asked at the moment. When something is, it turns up on your
  questions page.</p>
<p><a class="btn" href="{{action}}?step=3">Continue</a></p>
{{/anyQuestions}}
{{/onQuestions}}

{{#onDone}}
<h1>{{#returning}}Thank you{{/returning}}{{^returning}}That is everything{{/returning}}</h1>
{{#approved}}
<p class="lead">You are in. Have a look around &mdash; the discussion and what is coming up are in
  the bar at the top.</p>
{{/approved}}
{{^approved}}
<p class="lead">Thank you. Somebody who runs this community will look at what you have written and
  let you in; until then there is not much to see.</p>
{{/approved}}
<div class="doing">
  <a class="btn" href="{{homeUrl}}">Go to {{community}}</a>
  {{#hasSurvey}}<a class="btn secondary" href="{{surveyUrl}}">The questions</a>{{/hasSurvey}}
  <a class="btn secondary" href="{{selfUrl}}">Your profile</a>
</div>
{{/onDone}}
{{/body}}{{/layout}}
