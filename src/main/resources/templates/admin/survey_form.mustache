{{<shell}}{{$content}}
<p class="crumb"><a href="{{backUrl}}">&larr; Survey</a></p>
<h1>{{heading}}</h1>
<form class="editor" method="post" action="{{backUrl}}" data-question>
  <input type="hidden" name="csrf" value="{{csrf}}">
  <input type="hidden" name="action" value="save">
  {{#editing}}<input type="hidden" name="id" value="{{form_id}}">{{/editing}}

  <div><label for="q-prompt">what you are asking</label><textarea id="q-prompt" name="prompt" style="min-height:7rem;font:inherit" placeholder="What brought you here?" required>{{form_prompt}}</textarea></div>
  <div class="row"><div><label for="q-help">a hint underneath, if it needs one</label><input id="q-help" type="text" name="help" value="{{form_help}}"></div></div>

  <div class="row">
    <div>
      <label for="q-kind">how they answer</label>
      <select id="q-kind" name="kind" data-kind>{{#kinds}}<option value="{{value}}"{{#selected}} selected{{/selected}} data-describe="{{describe}}">{{label}}</option>{{/kinds}}</select>
      <p class="hint" data-kind-help></p>
    </div>
    <div><label for="q-position">order</label><input id="q-position" type="text" name="position" value="{{form_position}}"></div>
  </div>

  <div data-for="choice" class="hide">
    <label for="q-options">the options, one per line</label>
    <textarea id="q-options" name="options" style="min-height:7rem;font:inherit">{{form_options}}</textarea>
  </div>

  <div class="row hide" data-for="rating">
    <div><label for="q-min">lowest</label><input id="q-min" type="text" name="min" value="{{form_min}}"></div>
    <div><label for="q-max">highest</label><input id="q-max" type="text" name="max" value="{{form_max}}"></div>
  </div>

  <div class="row">
    <label class="check"><input type="checkbox" name="required"{{#form_required}} checked{{/form_required}}> everybody has to answer this</label>
    <label class="check"><input type="checkbox" name="published"{{#form_published}} checked{{/form_published}}> published</label>
  </div>
  <button type="submit">Save</button>
  <a href="{{backUrl}}" class="hint">cancel</a>
</form>
<script nonce="{{nonce}}">
// Show only the settings the chosen kind actually has, and say in words what the member will see.
// The sentences ride on data attributes, not interpolation.
(function () {
  var form = document.querySelector('[data-question]');
  if (!form) { return; }
  var kind = form.querySelector('[data-kind]');
  var help = form.querySelector('[data-kind-help]');
  var blocks = form.querySelectorAll('[data-for]');

  function apply() {
    var option = kind.options[kind.selectedIndex];
    var value = option ? option.value : '';
    help.textContent = option ? (option.getAttribute('data-describe') || '') : '';
    Array.prototype.forEach.call(blocks, function (block) {
      block.classList.toggle('hide', block.getAttribute('data-for') !== value);
    });
  }

  kind.addEventListener('change', apply);
  apply();
})();
</script>
{{/content}}{{/shell}}
