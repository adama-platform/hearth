<p class="count">{{count}} waiting</p>
{{^anyQuestions}}<p class="hint">Nothing is waiting to be cleaned up.</p>{{/anyQuestions}}
{{#anyQuestions}}<table>
  <thead><tr><th>question</th><th>kind</th><th class="num">answers</th><th></th></tr></thead>
  <tbody>{{#questions}}<tr>
    <td>{{prompt}}</td>
    <td class="dim">{{kind}}</td>
    <td class="num">{{answers}}</td>
    <td class="actions">
      <form class="inline" method="post" action="{{action}}"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="id" value="{{id}}"><input type="hidden" name="action" value="restore"><button type="submit">ask it again</button></form>
      <form class="inline" method="post" action="{{action}}" onsubmit="return confirm('Delete this question for good? Every answer to it will be stripped from every member\u2019s answers. This cannot be undone.')"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="id" value="{{id}}"><input type="hidden" name="action" value="purge"><button type="submit">delete for good</button></form>
    </td>
  </tr>{{/questions}}</tbody>
</table>
<p class="hint">Asking it again is free &mdash; the old answers are still attached and simply start
  counting again. Deleting for good is not reversible.</p>{{/anyQuestions}}
