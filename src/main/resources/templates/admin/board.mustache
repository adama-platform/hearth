{{<shell}}{{$content}}
<h1>Board</h1>
<p class="hint">Every conversation, including the ones that have aged out or been removed. Three
  things happen here &mdash; pin, lock, remove &mdash; and deliberately no fourth: editing somebody
  else's words and leaving their name on them is the one moderation power they cannot undo.</p>
<div class="doing"><a class="btn secondary" href="{{boardUrl}}">Open the board</a></div>
<form class="filters" data-filters method="get" action="{{panelUrl}}">
  <input type="search" name="q" value="{{q}}" placeholder="title or author">
  <button type="submit">Search</button>
</form>
<div class="panel" data-panel="{{panelUrl}}">{{{panel}}}</div>
{{/content}}{{/shell}}
