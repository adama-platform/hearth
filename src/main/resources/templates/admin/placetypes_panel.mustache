<p class="count">{{count}} kind(s)</p>
{{^anyKinds}}<p class="hint">None yet. A kind is the first thing the address book needs.</p>{{/anyKinds}}
{{#anyKinds}}<table>
  <thead><tr><th>kind</th><th class="num">records</th><th class="num">addresses</th><th>template</th><th></th></tr></thead>
  <tbody>{{#kinds}}<tr>
    <td><a href="{{editUrl}}">{{plural}}</a>
      {{^published}}<span class="pill dim">not listed</span>{{/published}}
      <div class="dim">{{description}}</div></td>
    <td class="num dim">{{fields}}</td>
    <td class="num dim">{{count}}</td>
    <td class="dim mono">{{template}}</td>
    <td class="actions">
      {{#canRemove}}<form class="inline" method="post" action="{{action}}" onsubmit="return confirm('Remove this kind? Its addresses move to Unsorted and nothing is deleted.')"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="slug" value="{{slug}}"><input type="hidden" name="action" value="delete"><button type="submit">delete</button></form>{{/canRemove}}
      {{^canRemove}}<span class="dim">where addresses go</span>{{/canRemove}}
    </td>
  </tr>{{/kinds}}</tbody>
</table>{{/anyKinds}}
