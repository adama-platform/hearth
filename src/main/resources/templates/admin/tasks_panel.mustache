<h2>The community's</h2>
{{^anyShared}}<p class="hint">None yet. Anything you start under <em>for the whole community</em>
  appears here.</p>{{/anyShared}}
{{#anyShared}}
<table>
  <thead><tr><th>project</th><th class="num">items</th><th class="num">open</th><th>shape</th><th>last touched</th><th></th></tr></thead>
  <tbody>{{#shared}}<tr>
    <td><a href="{{url}}">{{name}}</a>{{#summary}}<br><span class="dim">{{.}}</span>{{/summary}}</td>
    <td class="num">{{count}}</td>
    <td class="num">{{open}}</td>
    <td class="dim">{{#board}}board{{/board}}{{^board}}list{{/board}}</td>
    <td class="dim">{{touched}}</td>
    <td class="actions"><a href="{{url}}">open</a></td>
  </tr>{{/shared}}</tbody>
</table>
{{/anyShared}}

<h2>The shared library</h2>
{{^anyLibrary}}<p class="hint">Nothing shared yet. A definition in the library is one every member
  can take a copy of, and improving its instructions improves everybody's copy.</p>{{/anyLibrary}}
{{#anyLibrary}}
<table>
  <thead><tr><th>what</th><th>measured in</th><th>instructions</th><th></th></tr></thead>
  <tbody>{{#library}}<tr>
    <td><a href="{{url}}">{{name}}</a>{{#summary}}<br><span class="dim">{{.}}</span>{{/summary}}</td>
    <td class="dim">{{measure}}</td>
    <td>{{#hasInstructions}}<span class="pill good">written</span>{{/hasInstructions}}{{^hasInstructions}}<span class="pill warn">none</span>{{/hasInstructions}}</td>
    <td class="actions"><a href="{{url}}">open</a></td>
  </tr>{{/library}}</tbody>
</table>
<p class="hint">A definition with no instructions is a name in a list. The instructions are what
  somebody reads on a phone when they cannot remember the form.</p>
{{/anyLibrary}}

<h2>Members' own</h2>
<p class="hint">{{people}} member(s) keep something of their own. <strong>These are not openable
  from here, and that is deliberate.</strong> Knowing that people are using it is an administrative
  fact; what somebody lifted on Tuesday is theirs. If you genuinely need to see one, ask them
  &mdash; they can download the whole thing from their own page.</p>
{{#anyPersonal}}
<table>
  <thead><tr><th>whose</th><th>project</th><th class="num">items</th><th class="num">open</th><th>last touched</th></tr></thead>
  <tbody>{{#personal}}<tr>
    <td>{{who}}</td>
    <td>{{name}}</td>
    <td class="num">{{count}}</td>
    <td class="num">{{open}}</td>
    <td class="dim">{{touched}}</td>
  </tr>{{/personal}}</tbody>
</table>
{{/anyPersonal}}
{{^anyPersonal}}<p class="hint">Nobody has started one yet.</p>{{/anyPersonal}}
